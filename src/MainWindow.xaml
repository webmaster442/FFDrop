<Window
    x:Class="FFDrop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FFDrop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:FFDrop.Model"
    Title="FFDrop"
    Width="800"
    Height="450"
    AllowDrop="True"
    DragEnter="Window_DragEnter"
    DragOver="Window_DragOver"
    Drop="Window_Drop"
    ResizeMode="CanMinimize"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">
    <TabControl TabStripPlacement="Bottom">
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xE8AB;" />
                    <TextBlock Text="Convert" />
                </StackPanel>
            </TabItem.Header>
            <Grid ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="80" />
                </Grid.RowDefinitions>
                <GroupBox
                    Grid.RowSpan="2"
                    Grid.Column="0">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Text="&#xE8F1;" />
                            <TextBlock Text="Presets" />
                        </StackPanel>
                    </GroupBox.Header>
                    <TreeView
                        ItemsSource="{Binding Presets}"
                        SelectedItemChanged="OnSelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate
                                DataType="{x:Type model:PresetViewModel}"
                                ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </GroupBox>
                <Viewbox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,40">
                    <TextBlock
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Foreground="{StaticResource AccentTextFillColorPrimaryBrush}"
                        Text="&#xEC57;" />
                </Viewbox>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="16"
                    Text="Drag &amp; Drop files here" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    Text="{Binding SelectedPreset.AssociatedPreset.Description}"
                    TextWrapping="Wrap" />
            </Grid>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xE713;" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </TabItem.Header>
            <StackPanel Margin="5">
                <TextBlock
                    Margin="0,10"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Behaviour" />
                <RadioButton
                    Margin="10,0"
                    Content="Create shell script &amp; ask to run it"
                    GroupName="Behaviour"
                    IsChecked="{Binding Settings.CreateShellConfirmRun}" />
                <RadioButton
                    Margin="10,0"
                    Content="Create shell script &amp; start on drop"
                    GroupName="Behaviour"
                    IsChecked="{Binding Settings.CreateShellRun}" />
                <RadioButton
                    Margin="10,0"
                    Content="Crearte only shell script"
                    GroupName="Behaviour"
                    IsChecked="{Binding Settings.CreateShell}" />
                <Separator Margin="0,10" />
                <TextBlock
                    Margin="0,10"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Output folder" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Margin="10,0"
                        Text="{Binding Settings.OutputDirectory}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding Settings.BrowseCommand}"
                        Content="Browse..."
                        Style="{DynamicResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
