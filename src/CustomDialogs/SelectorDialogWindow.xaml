<Window
    x:Class="FFDrop.CustomDialogs.SelectorDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FFDrop.CustomDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DialogTitle"
    Width="800"
    Height="450"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ListBox
            x:Name="LstOptions"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        Text="{Binding}"
                        TextAlignment="Center" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentTextFillColorSecondaryBrush}" />
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid
                        Columns="4"
                        IsItemsHost="True" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <TextBlock
            x:Name="TxtDescription"
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="10"
            Text="Please make a selection:" />
        <Button
            x:Name="BtnOk"
            Grid.Row="2"
            Grid.Column="1"
            Width="120"
            Height="32"
            Margin="10"
            Click="BtnOk_Click"
            Content="Ok"
            Style="{DynamicResource AccentButtonStyle}" />
        <Button
            x:Name="BtnCancel"
            Grid.Row="2"
            Grid.Column="2"
            Width="120"
            Height="32"
            Margin="10"
            Click="BtnCancel_Click"
            Content="Cancel" />
    </Grid>
</Window>
