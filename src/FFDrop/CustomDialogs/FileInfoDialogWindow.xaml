<Window
    x:Class="FFDrop.CustomDialogs.FileInfoDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FFDrop.CustomDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="File Info"
    Width="500"
    Height="720"
    Style="{StaticResource Subdialog}"
    mc:Ignorable="d">
    <Grid
        Margin="10"
        ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TreeView
            x:Name="FileInfoTreeView"
            Grid.ColumnSpan="3">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Details}">
                    <TextBlock
                        MaxWidth="440"
                        Text="{Binding Summary}"
                        TextWrapping="Wrap" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
        <Button
            x:Name="Ok"
            Grid.Row="2"
            Grid.Column="2"
            Width="120"
            Height="32"
            Margin="10"
            Click="Ok_Click"
            Content="Ok" />
    </Grid>
</Window>
