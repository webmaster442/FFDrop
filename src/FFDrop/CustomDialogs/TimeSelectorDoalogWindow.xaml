<Window
    x:Class="FFDrop.CustomDialogs.TimeSelectorDoalogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FFDrop.CustomDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Select time span to cut"
    Height="250"
    Style="{StaticResource Subdialog}"
    mc:Ignorable="d">
    <Grid
        Margin="10"
        ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="TxtDescription"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="10"
                Text="Description" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="5"
                Text="Cut from:" />
            <TextBox
                x:Name="TbCutFrom"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,10"
                VerticalAlignment="Center"
                Text="{Binding FromTime}" />
            <CheckBox
                Grid.Row="2"
                Grid.Column="0"
                Margin="5"
                Content="Cut to:"
                IsChecked="{Binding IsToEnabled}" />
            <TextBox
                x:Name="TbCutTo"
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,10"
                VerticalAlignment="Center"
                IsEnabled="{Binding IsToEnabled}"
                Text="{Binding ToTime}" />
        </Grid>
        <Button
            x:Name="BtnOk"
            Grid.Row="2"
            Grid.Column="1"
            Width="120"
            Height="32"
            Margin="10"
            Click="BtnOk_Click"
            Content="Ok"
            Style="{DynamicResource AccentButtonStyle}" />
        <Button
            x:Name="BtnCancel"
            Grid.Row="2"
            Grid.Column="2"
            Width="120"
            Height="32"
            Margin="10"
            Click="BtnCancel_Click"
            Content="Cancel" />
    </Grid>
</Window>
